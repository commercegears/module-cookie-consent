<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="CommerceGears\CookieConsent\Api\Data\ScriptInterface" type="CommerceGears\CookieConsent\Model\Script"/>
    <preference for="CommerceGears\CookieConsent\Api\ScriptRepositoryInterface" type="CommerceGears\CookieConsent\Model\ScriptRepository"/>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="commercegears_cookieconsent_bump_version" xsi:type="object">CommerceGears\CookieConsent\Console\Command\BumpVersion</item>
                <item name="commercegears_cookieconsent_clean_log" xsi:type="object">CommerceGears\CookieConsent\Console\Command\CleanLog</item>
            </argument>
        </arguments>
    </type>
    <type name="CommerceGears\CookieConsent\Console\Command\BumpVersion">
        <arguments>
            <argument name="configWriter" xsi:type="object">Magento\Framework\App\Config\Storage\WriterInterface\Proxy</argument>
        </arguments>
    </type>

    <virtualType name="CommerceGears\CookieConsent\Model\ResourceModel\Script\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">commercegears_cookieconsent_script</argument>
            <argument name="resourceModel" xsi:type="string">CommerceGears\CookieConsent\Model\ResourceModel\Script</argument>
        </arguments>
    </virtualType>
    <virtualType name="CommerceGears\CookieConsent\Model\ResourceModel\Log\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">commercegears_cookieconsent_log</argument>
            <argument name="resourceModel" xsi:type="string">CommerceGears\CookieConsent\Model\ResourceModel\Log</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="commercegears_cookieconsent_script_listing_data_source" xsi:type="string">CommerceGears\CookieConsent\Model\ResourceModel\Script\Grid\Collection</item>
                <item name="commercegears_cookieconsent_log_listing_data_source" xsi:type="string">CommerceGears\CookieConsent\Model\ResourceModel\Log\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <!-- Global, not etc/frontend: an area-level "collectors" argument would replace Magento's collectors instead of
         adding to them. The collector itself only works in the frontend area. -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="commercegears_cookieconsent_scripts" xsi:type="object" sortOrder="4">CommerceGears\CookieConsent\Model\Csp\ScriptHostCollector\Proxy</item>
            </argument>
        </arguments>
    </type>
</config>
