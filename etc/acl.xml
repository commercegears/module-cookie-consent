<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="CommerceGears_Core::core" title="CommerceGears" translate="title" sortOrder="50">
                    <resource id="CommerceGears_CookieConsent::main" title="Cookie Consent" translate="title" sortOrder="30">
                        <resource id="CommerceGears_CookieConsent::scripts" title="Manage Third-party Scripts (site JavaScript)" translate="title" sortOrder="10"/>
                        <resource id="CommerceGears_CookieConsent::log" title="View Consent Log" translate="title" sortOrder="20">
                            <resource id="CommerceGears_CookieConsent::log_delete" title="Delete Consent Log Entries" translate="title" sortOrder="10"/>
                        </resource>
                        <resource id="CommerceGears_CookieConsent::config" title="Cookie Consent Settings" translate="title" sortOrder="30"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
