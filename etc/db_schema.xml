<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="softaware_cookieconsent_script" resource="default" engine="innodb" comment="Softaware Cookie Consent: consent-gated third-party scripts">
        <column xsi:type="int" name="script_id" unsigned="true" nullable="false" identity="true" comment="Script ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Admin name"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is active"/>
        <column xsi:type="varchar" name="category" nullable="false" length="32" default="analytics" comment="Consent category code"/>
        <column xsi:type="varchar" name="position" nullable="false" length="16" default="body_end" comment="head or body_end"/>
        <column xsi:type="varchar" name="store_ids" nullable="false" length="255" default="0" comment="Comma-separated store view ids, 0 = all"/>
        <column xsi:type="int" name="sort_order" unsigned="false" nullable="false" default="0" comment="Sort order"/>
        <column xsi:type="mediumtext" name="content" nullable="true" comment="HTML snippet"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="script_id"/>
        </constraint>
        <index referenceId="SOFTAWARE_COOKIECONSENT_SCRIPT_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>
    <table name="softaware_cookieconsent_log" resource="default" engine="innodb" comment="Softaware Cookie Consent: consent log">
        <column xsi:type="bigint" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="varchar" name="consent_id" nullable="false" length="64" comment="Random visitor consent id (from the consent cookie)"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store view id"/>
        <column xsi:type="varchar" name="action" nullable="false" length="16" comment="accept_all, reject_all or custom"/>
        <column xsi:type="varchar" name="categories" nullable="false" length="512" comment="Accepted categories, comma-separated"/>
        <column xsi:type="int" name="consent_version" unsigned="true" nullable="false" default="1" comment="Consent version"/>
        <column xsi:type="varchar" name="ip_hash" nullable="true" length="64" comment="Keyed SHA-256 hash of the (truncated) IP"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <index referenceId="SOFTAWARE_COOKIECONSENT_LOG_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
        <index referenceId="SOFTAWARE_COOKIECONSENT_LOG_CONSENT_ID" indexType="btree">
            <column name="consent_id"/>
        </index>
    </table>
</schema>
