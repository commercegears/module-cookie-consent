<?xml version="1.0"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="commercegears_cookieconsent_settings_link" class="CommerceGears\CookieConsent\Block\Widget\SettingsLink" is_email_compatible="false">
        <label translate="true">CommerceGears Cookie Settings Link</label>
        <description translate="true">A link that opens the cookie preferences window</description>
        <parameters>
            <parameter name="label" xsi:type="text" visible="true">
                <label translate="true">Link Text</label>
                <description translate="true">Leave empty to use the "Cookie Settings" link text from the configuration.</description>
            </parameter>
            <parameter name="css_class" xsi:type="text" visible="true">
                <label translate="true">CSS Class</label>
            </parameter>
        </parameters>
    </widget>
</widgets>
