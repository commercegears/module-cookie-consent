<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_cookieconsent_script_listing.softaware_cookieconsent_script_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Script</label>
            </button>
        </buttons>
        <spinner>softaware_cookieconsent_script_columns</spinner>
        <deps>
            <dep>softaware_cookieconsent_script_listing.softaware_cookieconsent_script_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_cookieconsent_script_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">script_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Softaware_CookieConsent::scripts</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="softaware_cookieconsent_script_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>script_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected scripts?</message>
                        <title translate="true">Delete scripts</title>
                    </confirm>
                    <url path="swcookieconsent/script/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="softaware_cookieconsent_script_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>script_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="script_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="category" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Softaware\CookieConsent\Model\Config\Source\Categories"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Category</label>
            </settings>
        </column>
        <column name="position" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Softaware\CookieConsent\Model\Config\Source\ScriptPosition"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Position</label>
            </settings>
        </column>
        <column name="store_ids" class="Softaware\CookieConsent\Ui\Component\Listing\Column\StoreViews">
            <settings>
                <label translate="true">Store Views</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Softaware\CookieConsent\Model\Config\Source\ActiveStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="sort_order">
            <settings>
                <label translate="true">Sort Order</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Softaware\CookieConsent\Ui\Component\Listing\Column\ScriptActions">
            <settings>
                <indexField>script_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
