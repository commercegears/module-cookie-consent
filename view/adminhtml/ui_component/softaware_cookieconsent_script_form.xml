<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_cookieconsent_script_form.softaware_cookieconsent_script_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Script</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Softaware\CookieConsent\Block\Adminhtml\Script\Edit\BackButton"/>
            <button name="delete" class="Softaware\CookieConsent\Block\Adminhtml\Script\Edit\DeleteButton"/>
            <button name="save_continue" class="Softaware\CookieConsent\Block\Adminhtml\Script\Edit\SaveAndContinueButton"/>
            <button name="save" class="Softaware\CookieConsent\Block\Adminhtml\Script\Edit\SaveButton"/>
        </buttons>
        <namespace>softaware_cookieconsent_script_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>softaware_cookieconsent_script_form.softaware_cookieconsent_script_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_cookieconsent_script_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="swcookieconsent/script/save"/>
        </settings>
        <dataProvider class="Softaware\CookieConsent\Ui\DataProvider\ScriptFormDataProvider" name="softaware_cookieconsent_script_form_data_source">
            <settings>
                <requestFieldName>script_id</requestFieldName>
                <primaryFieldName>script_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="script_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <notice translate="true">For your reference only, for example "Meta Pixel" or "Hotjar".</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
            </settings>
        </field>
        <field name="category" formElement="select" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Cookie Category</label>
                <notice translate="true">The script runs only after the visitor accepts this category. Custom categories are added under Stores &gt; Configuration &gt; Softaware &gt; Cookie Consent.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\CookieConsent\Model\Config\Source\Categories"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="position" formElement="select" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Position</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\CookieConsent\Model\Config\Source\ScriptPosition"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="store_ids" formElement="multiselect" sortOrder="50">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Store Views</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Softaware\CookieConsent\Model\Config\Source\StoreViews"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="sort_order" formElement="input" sortOrder="60">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="content" formElement="textarea" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Snippet (HTML)</label>
                <notice translate="true">Paste the vendor&apos;s snippet as-is, including script tags. Script tags are rendered with type="text/plain" and run after consent; images, iframes, video and external stylesheets load after consent. Content inside noscript is left unchanged. Add data-sw-consent="necessary" to a tag that must always run.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>14</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
    </fieldset>
</form>
