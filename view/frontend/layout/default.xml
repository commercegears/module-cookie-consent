<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="CommerceGears_CookieConsent::css/consent.css"/>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block class="CommerceGears\CookieConsent\Block\Scripts" name="commercegears.cookieconsent.scripts.head">
                <arguments>
                    <argument name="position" xsi:type="string">head</argument>
                </arguments>
            </block>
        </referenceBlock>
        <!-- The banner is fixed-positioned, so its place in the HTML does not change the layout. At the start of
             <body> it is parsed and painted with the first screen (and comes first for keyboard and screen readers). -->
        <referenceContainer name="after.body.start">
            <block class="Magento\Framework\View\Element\Template" name="commercegears.cookieconsent.banner"
                   template="CommerceGears_CookieConsent::banner.phtml" before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">CommerceGears\CookieConsent\ViewModel\Banner</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="CommerceGears\CookieConsent\Block\Scripts" name="commercegears.cookieconsent.scripts.body"
                   before="-">
                <arguments>
                    <argument name="position" xsi:type="string">body_end</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="footer_links">
            <block class="Magento\Framework\View\Element\Template" name="commercegears.cookieconsent.footer.link"
                   template="CommerceGears_CookieConsent::footer-link.phtml" after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">CommerceGears\CookieConsent\ViewModel\Banner</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
