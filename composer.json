{
    "name": "commercegears/module-cookie-consent",
    "description": "Cookie consent banner and preferences centre with Google Consent Mode v2, consent-based script blocking and an optional consent log. Works on Luma and Hyvä.",
    "type": "magento2-module",
    "license": "proprietary",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "~103.0.7",
        "commercegears/module-core": "^2.0",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-cookie": "*",
        "magento/module-store": "*",
        "magento/module-ui": "*",
        "magento/module-widget": "*",
        "magento/module-csp": "*",
        "magento/module-page-cache": "*",
        "magento/module-theme": "*"
    },
    "suggest": {
        "hyva-themes/magento2-default-theme": "Hyvä storefront support (templates included)",
        "commercegears/module-ga4-gtm": "^2.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceGears\\CookieConsent\\": ""
        }
    },
    "replace": {
        "softaware/module-cookie-consent": "*"
    }
}
